  </div>
</footer>

<script>
  // Scroll reveal
  const reveals = document.querySelectorAll('.reveal');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('visible');
        observer.unobserve(e.target);
      }
    });
  }, { threshold: 0.1 });
  reveals.forEach(el => observer.observe(el));

  // Form submission → sends email via mailto
  document.getElementById('registrationForm').addEventListener('submit', function(e) {
    e.preventDefault();
    const f = this;
    const data = {
      student: document.getElementById('studentName').value,
      age: document.getElementById('age').value,
      parent: document.getElementById('parentName').value,
      phone: document.getElementById('phone').value,
      course: document.getElementById('course').value,
      notes: document.getElementById('notes').value
    };

    const subject = encodeURIComponent(`طلب تسجيل جديد – ${data.student} – ${data.course}`);
    const body = encodeURIComponent(
      `طلب تسجيل جديد في أكاديمية تحقيق الطموح\n\n` +
      `اسم التلميذ: ${data.student}\n` +
      `العمر / السنة: ${data.age}\n` +
      `اسم ولي الأمر: ${data.parent}\n` +
      `رقم الهاتف: ${data.phone}\n` +
      `الدورة المطلوبة: ${data.course}\n` +
      `ملاحظات: ${data.notes || 'لا توجد'}\n\n` +
      `-- تم الإرسال من موقع الأكاديمية --`
    );

    // Open mailto
    window.location.href = `mailto:anna2003929292@gmail.com?subject=${subject}&body=${body}`;

    // Show success
    f.style.display = 'none';
    document.getElementById('successMsg').style.display = 'block';
  });

  // Smooth scroll for nav links
  document.querySelectorAll('a[href^="#"]').forEach(a => {
    a.addEventListener('click', function(e) {
      const target = document.querySelector(this.getAttribute('href'));
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });
</script>
</body>
</html>
